// ra3fps_gui.rc -- resources for Ra3FpsTest.exe
//
// 2026-09-17 / portable-GUI session (Claude)
//
// ASCII ONLY. rc.exe reads this file in the ANSI codepage; a non-ASCII comment can make it
// drop the next line (the same accident that once shipped a decorated export name in
// src/framelab.def). Comments are English on purpose.
//
// The build stages this script, its manifest/header and the freshly built DLL together
// inside the selected build directory. rc.exe runs there, so FLAB_BUILD_DIR is respected.
// The shipped executable contains the DLL bytes; it contains no build-directory path.

#include "gui_res.h"

// The patcher DLL, embedded so the shipped tool is one file with no side files to lose.
// It is extracted to %TEMP% at run time (see ExtractDll in ra3fps_gui.cpp) -- we never write
// into the game folder, which is one of this project's standing rules.
IDR_FRAMELAB_DLL  RCDATA  "Ra3FrameLab.dll"

// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID. See ra3fps_gui.manifest for why each setting is there.
// Type 24 = RT_MANIFEST. Numeric type avoids an undefined symbol becoming a string type.
1 24 "ra3fps_gui.manifest"

// ID 1 = VS_VERSION_INFO, required by Windows file-version APIs.
1 VERSIONINFO
 FILEVERSION     0,2,1,0
 PRODUCTVERSION  0,2,1,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 // Numeric literals instead of VOS_NT_WINDOWS32 / VFT_APP / VFT2_UNKNOWN: those names live in
 // winver.h, and rc.exe resolves them through INCLUDE. Spelling them out removes a way for the
 // build to depend on the environment it happens to run in.
 FILEOS          0x00040004L   // VOS_NT_WINDOWS32
 FILETYPE        0x00000001L   // VFT_APP
 FILESUBTYPE     0x00000000L   // VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = Simplified Chinese, 04b0 = Unicode. The strings are ASCII anyway.
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Ra3 FrameLab"
            VALUE "FileDescription",  "Red Alert 3 frame-rate test tool (runtime memory patch)"
            VALUE "FileVersion",      "0.2.1.0"
            VALUE "InternalName",     "Ra3FpsTest"
            VALUE "OriginalFilename", "Ra3FpsTest.exe"
            VALUE "ProductName",      "Ra3 FrameLab Test Tool"
            VALUE "ProductVersion",   "0.2.1.0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Ra3 FrameLab contributors."
            VALUE "Comments",         "Non-commercial use only. See LICENSE. Patches the running game in memory only. No game file is modified or replaced."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
